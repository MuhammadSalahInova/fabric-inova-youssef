/// Data describing each sold order data including the order details
table factsales
	lineageTag: 969bab32-125a-4907-abc2-69da8199f954
	sourceLineageTag: [Semantic].[factsales]

	/// Sum of ordered products sales value
	measure 'Total Ordered NetSales' =
			
			SUM(factsales[NetSales])
		lineageTag: 7c25c9c0-ffd5-47a4-b28d-4c3aeef4e4bc

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of shipped products sales value
	measure 'Total Shipped NetSales' =
			
			CALCULATE(
			    [Total Ordered NetSales],
			    USERELATIONSHIP(
			        DimDate[DateSK],
			        FactSales[ShippedDateSK]
			    )
			)
		lineageTag: 2af7f2b8-5a85-4b6f-bc3d-4f0ecdd9fb64

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

